{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');if(!fs.existsSync('node_modules/cesium')||(process.platform==='linux'&&!fs.existsSync('node_modules/@rolldown/binding-linux-x64-gnu'))){fs.rmSync('node_modules',{recursive:true,force:true})}\"",
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test src/shared/marsGrid/marsGrid.test.js src/modes/map/scripts/camera.test.js src/shared/pathPlanning/tests/astar.test.js src/shared/pathPlanning/tests/dijkstra.test.js src/shared/pathPlanning/tests/costModel.test.js src/shared/pathPlanning/tests/pathValidation.test.js src/shared/pathPlanning/tests/travelTime.test.js src/shared/pathPlanning/tests/recommendation.test.js src/shared/environment/tests/weather.test.js",
    "test:grid": "node --test src/shared/marsGrid/marsGrid.test.js",
    "test:paths": "node --test src/shared/pathPlanning/tests/astar.test.js src/shared/pathPlanning/tests/dijkstra.test.js src/shared/pathPlanning/tests/costModel.test.js src/shared/pathPlanning/tests/pathValidation.test.js",
    "benchmark:paths": "node scripts/benchmark-path-planning.mjs",
    "validate:grid": "node scripts/validate-mars-grid.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "cesium": "^1.147.0",
    "geotiff": "^3.1.0-beta.0",
    "lucide-react": "^1.73.0",
    "ol": "^10.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "vite-plugin-static-copy": "^4.1.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
